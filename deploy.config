# Deploy settings for this client — used by `npm run deploy` (scripts/deploy.sh).
# Another client: new branch deploy/<client> from main, copy this file, change the values.
# The FTP password is NOT kept here: put it in deploy.password.local (git-ignored) or type it when asked.

CLIENT_NAME="BGM"
SITE_URL="https://pride.viralsakhiya.com/mdm/"

# FTP server
FTP_HOST="68.178.156.64"         # server IP (ftp.solvitconsultancy.co.in has no DNS record)
FTP_PORT="21"
FTP_USER=""                      # TODO: the FTP account for the /mdm folder (deploy stops while empty)
FTP_PATH="/"                     # TODO: the folder that account opens in (/ if it opens in .../mdm)
FTP_SECURE="no"                 # yes = FTPS (FTP over TLS)

# build
BASE_PATH="/mdm/"               # the URL folder the app runs under
TENANT_KEY=""                   # TODO: the new tenant's key
