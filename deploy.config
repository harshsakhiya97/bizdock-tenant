# Deploy settings for this client — used by `npm run deploy` (scripts/deploy.sh).
# Another client: new branch deploy/<client> from main, copy this file, change the values.
# The FTP password is NOT kept here: put it in deploy.password.local (git-ignored) or type it when asked.

CLIENT_NAME="Pride"
SITE_URL="https://pride.viralsakhiya.com/pride/"

# FTP server
FTP_HOST="ftp.solvitconsultancy.co.in"   # or the IP 68.178.156.64
FTP_PORT="21"
FTP_USER="pride@pride.viralsakhiya.com"
FTP_PATH="/"                     # this FTP account already opens in .../pride.viralsakhiya.com/pride
FTP_SECURE="no"                 # yes = FTPS (FTP over TLS)

# build
BASE_PATH="/pride/"             # the URL folder the app runs under
TENANT_KEY=""                   # empty = the workspace is found from the domain
